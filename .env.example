# Copy to .env (git-ignored) and fill in. Services read it on startup.

# Admin account created by identity on startup if it does not exist.
ADMIN_EMAIL=admin@example.co.nz
ADMIN_PASSWORD=change-me-to-something-long

# Cloudflare R2 bucket for deal images (S3-compatible API).
# Endpoint: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=dealdrop-dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public URL images are served from, e.g. https://pub-<id>.r2.dev
R2_PUBLIC_BASE_URL=
